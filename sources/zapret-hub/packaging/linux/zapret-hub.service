[Unit]
Description=Zapret Hub — обход блокировок (zapret, стратегии Flowseal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/lib/zapret-hub/zapret-hub-helper fw-up
ExecStart=/usr/lib/zapret-hub/zapret-hub-helper run
ExecStopPost=/usr/lib/zapret-hub/zapret-hub-helper fw-down
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
