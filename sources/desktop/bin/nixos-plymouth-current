#!/bin/bash

# nixos:summary=Show which theme is styling the Plymouth boot screen
# nixos:examples=nixos plymouth current

# nixos-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/nixos/logo.png

if cmp -s "$NIXOS_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

nixos-plymouth-list | while read -r name; do
  if cmp -s "$(nixos-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
