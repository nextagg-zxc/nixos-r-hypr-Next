#!/bin/bash

# nixos:summary=Get or set the default dictation backend
# nixos:args=[backend]
# nixos:examples=nixos default dictation | nixos default dictation superwhisper

if (($# > 1)); then
  echo "Usage: nixos default dictation [backend]" >&2
  exit 1
fi

if (($# == 0)); then
  config="${XDG_CONFIG_HOME:-$HOME/.config}/nixos/defaults/dictation"
  if [[ ! -s $config ]]; then
    echo "No dictation backend configured. Select one in Setup > Defaults > Dictation." >&2
    exit 1
  fi
  read -r backend < "$config"
else
  backend=$1
fi

if [[ ! $backend =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid dictation backend: $backend" >&2
  exit 1
fi

if (($# == 0)); then
  echo "$backend"
else
  installer="nixos-install-dictation-$backend"
  if nixos-cmd-missing "$installer"; then
    echo "No installer available for dictation backend: $backend" >&2
    exit 1
  fi
  nixos-launch-floating-terminal-with-presentation "$installer"
fi
