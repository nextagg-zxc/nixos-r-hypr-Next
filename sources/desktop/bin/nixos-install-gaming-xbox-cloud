#!/bin/bash

# nixos:summary=Install Xbox Cloud Gaming as a web app and launch it.
# nixos:group=install
# nixos:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
nixos-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid nixos-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
