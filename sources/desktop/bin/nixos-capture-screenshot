#!/bin/bash

# nixos:summary=Take a screenshot
# nixos:group=capture
# nixos:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# nixos:examples=nixos screenshot | nixos capture screenshot region
# nixos:aliases=nixos screenshot

if [[ -n ${NIXOS_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$NIXOS_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   nixos-i18n capture.screenshotSaved, nixos-i18n capture.screenshotSavedCopied,
#   nixos-i18n capture.screenshotOpen, nixos-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
