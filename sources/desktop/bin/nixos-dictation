#!/bin/bash

# nixos:summary=Record dictation with the configured backend
# nixos:args=<start|stop|toggle>
# nixos:examples=nixos dictation start | nixos dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: nixos dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/nixos/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(nixos-default-dictation) || exit 1
adapter="nixos-dictation-$backend"
if nixos-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
