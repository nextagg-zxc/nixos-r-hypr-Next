#!/bin/bash

# nixos:summary=Disable a shell plugin
# nixos:group=plugin
# nixos:args=<id>

set -euo pipefail

fail() {
  echo "nixos-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: nixos plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(nixos-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: nixos-shell shell rescanPlugins"

echo "Disabled $id"
