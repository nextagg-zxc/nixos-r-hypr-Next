#!/bin/bash

# nixos:summary=Launch or focus on a given web app identified by the window-pattern.
# nixos:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: nixos-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="nixos-launch-webapp $@"

exec nixos-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
