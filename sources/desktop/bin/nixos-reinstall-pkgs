#!/bin/bash

# nixos:summary=Reinstall all default NixOS packages from the stable channel, or on Apple Silicon the edge channel
# nixos:requires-sudo=true

set -e

# Reinstall all default NixOS packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$NIXOS_PATH/install/helpers/pacman.sh"
platform=$(nixos-hw-platform)
channel=$(nixos_pacman_default_channel "$platform")
nixos-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
nixos-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(nixos-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for nixos-power-profiles-daemon.
nixos-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
