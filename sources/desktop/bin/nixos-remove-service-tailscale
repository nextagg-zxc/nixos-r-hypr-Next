#!/bin/bash

# nixos:summary=Remove Tailscale and its bar plugin.
# nixos:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now nixos-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
nixos-plugin-disable nixos.tailscale
nixos-webapp-remove "Tailscale" 2>/dev/null || true
nixos-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
