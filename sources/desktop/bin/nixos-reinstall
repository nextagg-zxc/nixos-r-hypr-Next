#!/bin/bash

# nixos:summary=Reinstall NixOS packages and reset default configs
# nixos:requires-sudo=true

set -e

echo -e "This will reinstall all default NixOS packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  nixos-reinstall-pkgs
  nixos-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && nixos-system reboot
fi
