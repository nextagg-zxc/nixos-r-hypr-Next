#!/bin/bash

# nixos:summary=Remove Dropbox and its bar plugin.
# nixos:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
nixos-plugin-disable nixos.dropbox
nixos-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Other tray apps need libappindicator too, and naming a required package fails the whole removal
if pacman -Qqtt libappindicator &>/dev/null; then
  nixos-pkg-drop libappindicator
fi

echo ""
echo "Dropbox has been removed."
