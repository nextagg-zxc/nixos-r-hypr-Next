#!/bin/bash

# nixos:summary=Send the low battery warning notification and run battery-low hooks.
# nixos:args=<percentage>
# nixos:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: nixos-battery-low <percentage>" >&2
  exit 1
fi

level=$1

nixos-notification-send -g 󱐋 -u normal "$(nixos-i18n battery.lowTitle)" "$(nixos-i18n battery.lowBody "$level")" -i battery-caution -t 30000
nixos-hook battery-low "$level"
