#!/bin/bash

# nixos:summary=Remove Steam and all of its game libraries, configs, and caches.
# nixos:requires-sudo=true

set -e

nixos-lifecycle-dispatch pre-remove steam
nixos-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
