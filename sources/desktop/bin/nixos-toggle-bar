#!/bin/bash

# nixos:summary=Toggle bar visibility without killing the NixOS shell (on hides the bar, off shows it)
# nixos:args=[toggle|on|off]
# nixos:examples=nixos toggle bar | nixos toggle bar off | nixos toggle bar on

nixos-toggle bar-off "${1:-toggle}"

# The shell's watch on the toggles directory can miss flag changes that land in
# quick succession, stranding the bar off screen until the shell restarts.
# Nudge the bar to re-read the flag; quiet best-effort so the toggle still
# works when the shell is not up.
nixos-shell -q nixos.bar syncHidden
