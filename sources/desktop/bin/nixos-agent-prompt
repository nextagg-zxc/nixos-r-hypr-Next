#!/bin/bash

# nixos:summary=Launch the default coding agent with a prompt
# nixos:args=[--inline] <prompt...>
# nixos:examples=nixos agent prompt "Review this project"

# Prompts live here rather than on `nixos agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: nixos agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec nixos-agent "${inline[@]}" --prompt "$*"
