#!/bin/bash

# nixos:summary=Apply NixOS hardware-specific packages and system configuration
# nixos:group=apply
# nixos:requires-sudo=true
# nixos:examples=nixos apply hardware --install-user dhh
# nixos:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: nixos apply hardware --install-user USER
       nixos apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by nixos-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/nixos/provisioning/groups.

In an image build (/var/lib/nixos/image/target exists) nothing runs here: every step is queued
for nixos-provision-hardware on the machine's first boot.
USAGE
}

install_user="${NIXOS_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: nixos-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export NIXOS_INSTALL_USER="$install_user"
# Only nixos-provision-hardware runs steps as an image's first boot.
unset NIXOS_IMAGE_DEFERRED_HARDWARE
export NIXOS_PATH="${NIXOS_PATH:-/usr/share/nixos}"
export NIXOS_INSTALL="${NIXOS_INSTALL:-$NIXOS_PATH/install}"
export NIXOS_INSTALL_LOG_FILE="${NIXOS_INSTALL_LOG_FILE:-/var/log/nixos-install.log}"
export PATH="$NIXOS_PATH/bin:$PATH"

source "$NIXOS_INSTALL/helpers/logging.sh"
source "$NIXOS_INSTALL/helpers/image-target.sh"

nixos_image_init
nixos_image_lock
if nixos_image_manifest_present; then
  nixos_image_read_manifest
  nixos_image_defer_hardware
else
  source "$NIXOS_INSTALL/hardware/all.sh"
fi
