#!/bin/bash

# nixos:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/nixos/current/theme.name" 2>/dev/null)

nixos-menu-images \
  --cache-only \
  "$HOME/.local/state/nixos/current/theme/backgrounds" \
  "$HOME/.config/nixos/backgrounds/$theme_name"
