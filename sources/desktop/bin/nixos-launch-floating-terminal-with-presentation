#!/bin/bash

# nixos:summary=Launch a floating terminal with the NixOS presentation wrapper
# nixos:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source nixos-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="nixos-show-logo; $cmd; code=\$?; if (( code != 130 )); then nixos-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.nixos.terminal --title=NixOS -e bash -c "$presentation_script"
