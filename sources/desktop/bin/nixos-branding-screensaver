#!/bin/bash

# nixos:summary=Edit, set, or reset screensaver branding
# nixos:group=branding
# nixos:name=screensaver
# nixos:args=<image|text|reset>
# nixos:examples=nixos branding screensaver image | nixos branding screensaver text | nixos branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(nixos-file-select --title "$(nixos-i18n branding.pickScreensaverImage)" --extensions "png svg")
  if nixos-transcode-ascii "$image" ~/.config/nixos/branding/screensaver.txt; then
    nixos-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  nixos-launch-editor ~/.config/nixos/branding/screensaver.txt >/dev/null 2>&1 && nixos-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$NIXOS_PATH/logo.txt" ~/.config/nixos/branding/screensaver.txt && nixos-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: nixos-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
