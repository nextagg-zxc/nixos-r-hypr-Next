#!/bin/bash

# nixos:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  nixos-brightness-keyboard-mute on
  nixos-osd -i microphone-muted -m "$(nixos-i18n audio.micMuted)"
else
  nixos-brightness-keyboard-mute off
  nixos-osd -i microphone -m "$(nixos-i18n audio.micOn)"
fi
