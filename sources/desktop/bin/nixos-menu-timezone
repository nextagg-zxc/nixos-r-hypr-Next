#!/bin/bash

# nixos:summary=Select and set the system timezone
# nixos:group=menu
# nixos:name=timezone

set -e

timezone=$(timedatectl list-timezones | nixos-menu-select "$(nixos-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
nixos-shell -q nixos.clock refresh
nixos-notification-send "$(nixos-i18n timezone.changed "$timezone")"
