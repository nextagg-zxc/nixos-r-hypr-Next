#!/bin/bash

# nixos:summary=Remove the GeForce NOW Flatpak app and its data.
# nixos:group=remove
# nixos:name=gaming geforce-now

set -e

if nixos-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
