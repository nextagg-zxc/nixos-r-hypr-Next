#!/bin/bash

# nixos:summary=Launch a TUI or focus an existing terminal window for it
# nixos:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.nixos.$(basename "$1")"
fi

LAUNCH_COMMAND="nixos-launch-tui $@"

exec nixos-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
