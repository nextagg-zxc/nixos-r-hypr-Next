#!/bin/bash

# nixos:summary=List available themes
# nixos:examples=nixos theme list | nixos theme set "Tokyo Night"

{
  find ~/.config/nixos/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$NIXOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
