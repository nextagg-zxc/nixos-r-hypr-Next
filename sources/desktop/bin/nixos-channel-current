#!/bin/bash

# nixos:summary=Print the active NixOS package channel

set -euo pipefail

# Dev is a linked source checkout: NIXOS_PATH points somewhere other than
# the package-backed install at /usr/share/nixos. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $NIXOS_PATH != "/usr/share/nixos" ]]; then
  echo dev
  exit 0
fi

# nixos-dev / nixos-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. nixos / nixos-settings come
# from either the stable or rc mirror, distinguished by nixos-version-channel
# (which reports the mirror as its first token).
if pacman -Q nixos-dev nixos-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q nixos nixos-settings >/dev/null 2>&1; then
  channel=$(nixos-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
