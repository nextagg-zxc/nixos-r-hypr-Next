#!/bin/bash

# nixos:summary=Record dictation using Voxtype
# nixos:args=<start|stop|toggle>

case "${1:-}" in
  start|toggle) voxtype record "$1" ;;
  stop)
    if nixos-cmd-missing voxtype || [[ $(voxtype status) == "stopped" ]]; then
      exit 0
    else
      voxtype record stop
    fi
    ;;
  *) echo "Usage: nixos dictation voxtype <start|stop|toggle>" >&2; exit 1 ;;
esac
