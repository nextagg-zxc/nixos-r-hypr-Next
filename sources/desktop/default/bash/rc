: "${NIXOS_PATH:=/usr/share/nixos}"
source "$NIXOS_PATH/default/bash/envs"
source "$NIXOS_PATH/default/bash/shell"
source "$NIXOS_PATH/default/bash/aliases"
source "$NIXOS_PATH/default/bash/functions"
source "$NIXOS_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$NIXOS_PATH/default/bash/inputrc"
