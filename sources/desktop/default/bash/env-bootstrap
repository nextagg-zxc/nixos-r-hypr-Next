# Single source of truth for NIXOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/nixos.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-nixos          (Hyprland session via uwsm)
#   /usr/share/nixos/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/nixos.conf is written by nixos-dev-link and reset by
# nixos-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/nixos.conf ]; then
  . /etc/nixos.conf
  : "${NIXOS_PATH:=/usr/share/nixos}"
else
  NIXOS_PATH=/usr/share/nixos
fi
export NIXOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/nixos-* via the nixos package — prepending
# /usr/share/nixos/bin would just be noise.
if [ "$NIXOS_PATH" != /usr/share/nixos ]; then
  case ":$PATH:" in
    *":${NIXOS_PATH%/}/bin:"*) ;;
    *) PATH="${NIXOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
nixos_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
nixos_wrapper_path=$nixos_wrapper_dir
if [ -n "${PATH:-}" ]; then
  nixos_remaining_path=$PATH
  while :; do
    nixos_path_entry=${nixos_remaining_path%%:*}
    if [ "$nixos_path_entry" != "$nixos_wrapper_dir" ]; then
      nixos_wrapper_path="$nixos_wrapper_path:$nixos_path_entry"
    fi
    case "$nixos_remaining_path" in
      *:*) nixos_remaining_path=${nixos_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$nixos_wrapper_path
unset nixos_wrapper_dir nixos_wrapper_path nixos_remaining_path nixos_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
