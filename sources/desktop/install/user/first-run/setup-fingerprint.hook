#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if nixos-hw-fingerprint && [[ ! -f /etc/pam.d/nixos-lock-fingerprint ]] &&
  nixos-done ensure fingerprint-setup-invitation; then
  nixos-notification-send -u critical -g 󰈷 "$(nixos-i18n firstRun.fingerprintTitle)" \
    "$(nixos-i18n firstRun.fingerprintBody)" \
    --exec nixos-launch-floating-terminal-with-presentation nixos-setup-security-fingerprint
fi
